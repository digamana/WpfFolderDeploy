<UserControl x:Class="auto_updater_wpf.Views.EnvSettingEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="載入 EnvSetting.json" Width="130" Height="30" Margin="0,0,8,0" Click="LoadButton_Click"/>
            <Button Content="儲存 EnvSetting.json" Width="130" Height="30" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#57606A"/>
        </StackPanel>
        <TextBox x:Name="EnvSettingTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"/>
    </Grid>
</UserControl>
