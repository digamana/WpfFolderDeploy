<Window x:Class="auto_updater_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:auto_updater_wpf.Views" 
        Title="{Binding AppTitle}" Icon="Assets/AppIcon.ico" Height="860" Width="1320"
        WindowStartupLocation="Manual"
        MinHeight="720" MinWidth="1120"
        Background="#F3F4F6">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#DAE8FC"/>
            <Setter Property="BorderBrush" Value="#6C8EBF"/>
        </Style>
        <Style x:Key="BackupButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D5E8D4"/>
            <Setter Property="BorderBrush" Value="#82B366"/>
        </Style>
        <Style x:Key="ReportButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFF2CC"/>
            <Setter Property="BorderBrush" Value="#D6B656"/>
        </Style>
        <DataTemplate x:Key="ServerTargetTemplate">
            <DockPanel LastChildFill="False" Margin="0,1,0,1">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Ip}" Foreground="#57606A" FontSize="12" VerticalAlignment="Center" Margin="3,0,5,0"/>
                <Button DockPanel.Dock="Left" Content="測" Command="{Binding TestConnectionCommand}" Width="28" Height="20" Padding="0" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="PublishJobTemplate">
            <Border Style="{StaticResource Card}" MinHeight="255">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="11" Height="11" Fill="{Binding StatusBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Memo}" Foreground="#3F4B57" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="18,0,0,6"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="📂" Command="{Binding OpenLocalFolderCommand}" Width="28" Height="24" Margin="6,0,0,0" ToolTip="開啟 Local 資料夾"/>
                            <TextBlock Text="{Binding LocalPath, StringFormat=Local: {0}}" Foreground="#57606A" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RemotePath, StringFormat=Remote: {0}}" Foreground="#57606A" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="IP:" Foreground="#57606A" FontSize="12" Margin="0,4,0,0"/>
                        <ItemsControl ItemsSource="{Binding ServerTargets}" ItemTemplate="{StaticResource ServerTargetTemplate}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <CheckBox Content="只傳修改日不同檔案" IsChecked="{Binding OnlyLastWriteTimeDiff}"/>
                        <CheckBox Content="只傳特定檔案" IsChecked="{Binding OnlySpecificFiles}"/>
                        <CheckBox Content="包含 appsettings.json" IsChecked="{Binding IncludeAppSettings}"/>
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="16" Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#57606A"/>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="0,8,0,0">
                        <TextBox Text="{Binding StatusLogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="34"
                                 MaxHeight="70"
                                 Foreground="{Binding StatusBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="發布" Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="備份" Command="{Binding BackupCommand}" Style="{StaticResource BackupButton}"/>
                            <Button Content="上傳明細" Command="{Binding ViewPublishReportCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPublishReport}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="建立部版環境" Command="{Binding SetupDeployEnvironmentCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSetupRequired}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Auto Updater WPF" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="projName 一列、Type 一欄；設定檔自動產生發布操作。" Foreground="#57606A" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LogFilePath}" Foreground="#57606A" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <TabControl Margin="14">
            <TabItem Header="發布">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                        <Button Content="ReLoad EnvSetting" Command="{Binding ReloadEnvSettingCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProjectRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="170" Background="#F6F8FA" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10" Margin="5">
                                            <TextBlock Text="{Binding ProjectName}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" Columns="{Binding DataContext.TypeColumns.Count, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="255">
                                                        <ContentControl Content="{Binding Job}" ContentTemplate="{StaticResource PublishJobTemplate}">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasJob}" Value="False">
                                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="特定檔案">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="只傳特定檔案清單" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SpecificFileIniPath, StringFormat=自動儲存檔案：{0}}" Foreground="#57606A" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox VerticalContentAlignment="Center" Width="360" Height="30" Text="{Binding SpecificFileInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Content="新增" Command="{Binding AddSpecificFileCommand}" Style="{StaticResource PrimaryButton}"/>
                            <Button Content="刪除選取" Command="{Binding RemoveSpecificFileCommand}" Style="{StaticResource BackupButton}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SpecificFiles}" SelectedItem="{Binding SelectedSpecificFile}" Margin="0,12,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="下載特定檔案">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" MinWidth="390">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="從遠端下載單一檔案"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Text="遠端 IP" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      VerticalContentAlignment="Center"
                                      Height="30"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding DownloadRemoteIps}"
                                      SelectedItem="{Binding DownloadRemoteIp}"/>

                            <TextBlock Grid.Row="2" Text="遠端檔案路徑" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      VerticalContentAlignment="Center"
                                      Height="30"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding DownloadRemoteFilePaths}"
                                      SelectedItem="{Binding DownloadRemoteFilePath}"/>

                            <TextBlock Grid.Row="3" Text="本機資料夾路徑" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     Height="30"
                                     Margin="0,0,0,8"
                                     Text="{Binding DownloadLocalFolderPath, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="下載"
                                        Command="{Binding DownloadSpecificFileCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <TextBlock Text="{Binding DownloadStatus}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="#57606A"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" MinWidth="390">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="維護遠端檔案路徑"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox VerticalContentAlignment="Center"
                                         Height="30"
                                         MinWidth="260"
                                         Text="{Binding DownloadRemoteFilePathInput, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"
                                         ToolTip="輸入遠端檔案完整路徑"/>
                                <Button Grid.Column="1"
                                        Content="新增"
                                        Command="{Binding AddDownloadRemoteFilePathCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox ItemsSource="{Binding DownloadRemoteFilePaths}"
                                         SelectedItem="{Binding DownloadRemoteFilePath}"
                                         MinHeight="150"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                                <Button Grid.Row="1"
                                        Content="刪除選取路徑"
                                        Command="{Binding RemoveDownloadRemoteFilePathCommand}"
                                        Style="{StaticResource BackupButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="差異比對">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                        <Button Content="新增一組" Command="{Binding AddDiffCompareItemCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="新增所有IP" Command="{Binding AddAllIpDiffCompareItemsCommand}" Style="{StaticResource BackupButton}" Margin="0,0,8,0"/>
                        <Button Content="全部差異比對" Command="{Binding CompareAllDiffCompareItemsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="全部刪除" Command="{Binding ClearDiffCompareItemsCommand}" Style="{StaticResource BackupButton}" Margin="0,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DiffCompareItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="380"/>
                                                <ColumnDefinition Width="380"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="260"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      VerticalContentAlignment="Center"
                                                      Height="30"
                                                      ItemsSource="{Binding IpOptions}"
                                                      SelectedItem="{Binding SelectedIp}"
                                                      Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1"
                                                     VerticalContentAlignment="Center"
                                                     Height="30"
                                                     Text="{Binding RemoteFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"
                                                     ToolTip="遠端檔案位置，例如 C:\Jay\dnSpy\APIServices.Dao.dll"
                                                     Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="2"
                                                     VerticalContentAlignment="Center"
                                                     Height="30"
                                                     Text="{Binding LocalFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"
                                                     ToolTip="本機檔案位置，例如 C:\Jay\dnSpy\APIServices.Dao.dll"
                                                     Margin="0,0,8,0"/>
                                            <Button Grid.Column="3"
                                                    Content="差異比對"
                                                    Command="{Binding CompareCommand}"
                                                    Style="{StaticResource PrimaryButton}"/>
                                            <Button Grid.Column="4"
                                                    Content="刪除"
                                                    Command="{Binding RemoveCommand}"
                                                    Style="{StaticResource BackupButton}"/>
                                            <Button Grid.Column="5"
                                                    Content="Detail"
                                                    Command="{Binding ViewDetailsCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetails}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Column="6"
                                                       Text="{Binding Result}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,8,0"
                                                       Foreground="#57606A"/>
                                            <TextBox Grid.Column="7"
                                                     VerticalContentAlignment="Center"
                                                     Height="30"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     TextWrapping="NoWrap"
                                                     ToolTip="備註：記錄這個差異是在比什麼"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="LOG">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="開啟 CMD 即時 Log" Command="{Binding OpenLogCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="專案" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="170" ItemsSource="{Binding LogProjectNames}" SelectedItem="{Binding SelectedLogProjectName}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="環境" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox Width="110" ItemsSource="{Binding LogTypeNames}" SelectedItem="{Binding SelectedLogTypeName}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="開始" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker Width="130" SelectedDate="{Binding LogStartDate}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="結束" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker Width="130" SelectedDate="{Binding LogEndDate}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="篩選" VerticalAlignment="Top" Margin="0,4,4,0"/>
                            <TextBox Width="220"
                                     Height="70"
                                     Text="{Binding LogFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="遠端LOG資料夾" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="260" IsReadOnly="True" Text="{Binding LogDownloadRemoteFilePath, Mode=OneWay}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                            <TextBlock Text="下載到" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Width="180" Text="{Binding LogDownloadLocalFolderPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Button Content="下載LOG" Command="{Binding DownloadLogFileCommand}" Style="{StaticResource BackupButton}" Margin="0,0,8,8"/>
                        <Button Content="載入LOG" Command="{Binding LoadLogsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <TextBlock Text="{Binding LogDownloadStatus}" Foreground="#57606A" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LoadedLogs}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              MouseDoubleClick="LoadedLogsGrid_MouseDoubleClick"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding FileDate, StringFormat=yyyy-MM-dd}" Width="110"/>
                            <DataGridTextColumn Header="專案" Binding="{Binding ProjectName}" Width="160"/>
                            <DataGridTextColumn Header="環境" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="檔案" Binding="{Binding FileName}" Width="230"/>
                            <DataGridTextColumn Header="內容" Binding="{Binding Content}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="環境設定(JSON)">
                <views:EnvSettingEditorControl />
            </TabItem>

            <TabItem Header="教學">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="儲存 README" Command="{Binding SaveReadmeCommand}" Style="{StaticResource PrimaryButton}"/>
                        <TextBlock Text="{Binding ReadmePath}" Foreground="#57606A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             Text="{Binding ReadmeText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
